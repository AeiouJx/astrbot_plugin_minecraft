{
    "minecraft_event_group": {
        "description": "Minecraft 事件推送群号",
        "type": "string",
        "hint": "留空不推送；填写 QQ 群号后，下方勾选的事件类型会推送到该群。",
        "default": ""
    },
    "push_chat": {
        "description": "推送聊天消息",
        "type": "bool",
        "hint": "将玩家公开聊天推送到 QQ 群。",
        "default": false
    },
    "push_whisper": {
        "description": "推送私聊消息",
        "type": "bool",
        "hint": "将玩家私聊消息推送到 QQ 群。",
        "default": false
    },
    "push_player_join": {
        "description": "推送玩家加入",
        "type": "bool",
        "hint": "玩家加入游戏时推送到 QQ 群。",
        "default": false
    },
    "push_player_leave": {
        "description": "推送玩家离开",
        "type": "bool",
        "hint": "玩家离开游戏时推送到 QQ 群。",
        "default": false
    },
    "push_death": {
        "description": "推送死亡事件",
        "type": "bool",
        "hint": "Bot 死亡时推送到 QQ 群。",
        "default": false
    },
    "push_achievement": {
        "description": "推送成就事件",
        "type": "bool",
        "hint": "玩家达成成就时推送到 QQ 群。",
        "default": false
    },
    "push_system": {
        "description": "推送系统消息",
        "type": "bool",
        "hint": "系统消息（如摔死、烧死等）推送到 QQ 群。",
        "default": false
    },
    "push_player_death": {
        "description": "推送玩家死亡",
        "type": "bool",
        "hint": "其他玩家（非Bot）死亡时推送到 QQ 群。",
        "default": true
    },
    "push_security": {
        "description": "推送攻击事件",
        "type": "bool",
        "hint": "玩家攻击Bot事件推送到 QQ 群。",
        "default": true
    },
    "push_connection_denied": {
        "description": "推送连接拒绝事件",
        "type": "bool",
        "hint": "黑名单/白名单玩家连接被拒事件推送到 QQ 群。",
        "default": true
    },
    "push_totem": {
        "description": "推送 Totem 事件",
        "type": "bool",
        "hint": "Totem 弹出/耗尽事件推送到 QQ 群。",
        "default": true
    },
    "push_visual": {
        "description": "推送视野事件",
        "type": "bool",
        "hint": "玩家进入/离开Bot视野、视野内下线等事件推送到 QQ 群。",
        "default": false
    },
    "push_queue": {
        "description": "推送排队事件",
        "type": "bool",
        "hint": "进服排队位置/排队完成事件推送到 QQ 群。",
        "default": true
    },
    "push_health": {
        "description": "推送血量事件",
        "type": "bool",
        "hint": "Bot血量过低/低血自动断线事件推送到 QQ 群。",
        "default": true
    },
    "push_scan": {
        "description": "推送扫描事件",
        "type": "bool",
        "hint": "扫描发现目标方块/实体事件推送到 QQ 群。",
        "default": true
    },
    "qq_content_filter": {
        "description": "违禁词过滤 (L1)",
        "type": "bool",
        "hint": "开启后，推送到 QQ 的消息会检查自定义违禁词列表，命中则不推送。",
        "default": true
    },
    "qq_blocked_words": {
        "description": "自定义违禁词列表",
        "type": "list",
        "hint": "包含这些词的消息不会推送到 QQ 群（不区分大小写）。可配合下方的 GroupGuardian 词库使用。",
        "default": []
    },
    "use_guardian_lexicon": {
        "description": "共享 GroupGuardian 词库 (L2)",
        "type": "bool",
        "hint": "开启后会读取 astrbot_plugin_group_guardian 的 lexicon.db 词库（66,000+ 条关键词），扩大过滤覆盖范围。需先安装该插件。",
        "default": false
    },
    "llm_moderation_enable": {
        "description": "AI 内容审核 (L3)",
        "type": "bool",
        "hint": "开启后，推送到 QQ 的消息会先发送给 LLM 判断是否安全，不安全的内容不会推送。会消耗少量 API 额度。",
        "default": false
    },
    "llm_moderation_provider": {
        "description": "AI 审核模型",
        "type": "string",
        "_special": "select_provider",
        "hint": "选择用于内容审核的模型提供商。留空则使用 AstrBot 默认模型。",
        "default": ""
    },
    "llm_moderation_prompt": {
        "description": "AI 审核提示词",
        "type": "string",
        "hint": "自定义 AI 审核的判断标准。留空使用内置默认提示词。",
        "default": ""
    },
    "max_message_length": {
        "description": "最大聊天长度",
        "type": "int",
        "hint": "单条 Minecraft 消息转发到 AstrBot 前允许的最大长度；超出部分会被截断。",
        "slider": {"min": 100, "max": 5000, "step": 100},
        "default": 1000
    },
    "chat_rate_limit": {
        "description": "发言频率限制",
        "type": "int",
        "hint": "每个时间窗口内最多发送的消息数量（0=不限制）。",
        "slider": {"min": 0, "max": 30, "step": 1},
        "default": 5
    },
    "chat_rate_window": {
        "description": "发言频率窗口（秒）",
        "type": "int",
        "hint": "频率限制的时间窗口大小（秒）。",
        "slider": {"min": 10, "max": 300, "step": 10},
        "default": 60
    },
    "llm": {
        "description": "LLM 回复",
        "type": "object",
        "items": {
            "weight": {
                "description": "触发权重",
                "hint": "触发概率 = 本权重 / 所有权重之和",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 100,
                    "step": 1
                },
                "default": 10
            },
            "template": {
                "description": "LLM 提示模板",
                "type": "text",
                "hint": "触发 LLM 回复时的提示模板",
                "default": "你是一个 Minecraft 游戏中的玩家。回复要简短（不超过50字符），口语化，像玩家聊天一样。不要用markdown格式。不要用emoji。"
            }
        }
    },
    "llm_reply_provider": {
        "description": "LLM 回复模型",
        "type": "string",
        "_special": "select_provider",
        "hint": "选择用于 MC 聊天自动回复的模型提供商。留空使用 AstrBot 默认模型。",
        "default": ""
    },
    "focus_templates_list": {
        "description": "🎯 重点关注推送至群聊模板库",
        "hint": "添加重点关注规则：指定 QQ 群和要关注的 Minecraft 玩家，命中玩家使用模板配置，推送事件到对应群。群项留空时回退到全局配置",
        "type": "template_list",
        "templates": {
            "focus_entry": {
                "name": "关注规则",
                "hint": "添加一条重点关注规则",
                "display_item": "group",
                "items": {
                    "players": {
                        "description": "关注玩家列表",
                        "type": "list",
                        "hint": "填写 Minecraft 用户名",
                        "default": []
                    },
                    "group": {
                        "description": "推送目标群号",
                        "type": "string",
                        "hint": "该玩家的事件会推送到这个 QQ 群",
                        "default": ""
                    },
                    "push_chat": {
                        "description": "推送聊天",
                        "type": "bool",
                        "hint": "推送该玩家的聊天消息",
                        "default": true
                    },
                    "push_join_leave": {
                        "description": "推送加入/退出",
                        "type": "bool",
                        "hint": "推送该玩家加入或离开游戏的事件",
                        "default": true
                    },
                    "push_death": {
                        "description": "推送死亡",
                        "type": "bool",
                        "hint": "推送该玩家的死亡事件",
                        "default": true
                    },
                    "push_achievement": {
                        "description": "推送成就",
                        "type": "bool",
                        "hint": "推送该玩家的成就事件",
                        "default": true
                    },
                    "push_player_death": {
                        "description": "推送玩家死亡",
                        "type": "bool",
                        "hint": "推送该玩家（非Bot）的死亡事件",
                        "default": true
                    },
                    "push_attack": {
                        "description": "推送攻击事件",
                        "type": "bool",
                        "hint": "推送该玩家攻击Bot的事件",
                        "default": true
                    },
                    "push_visual": {
                        "description": "推送视野事件",
                        "type": "bool",
                        "hint": "推送该玩家进入/离开Bot视野的事件",
                        "default": false
                    },
                    "push_whisper": {
                        "description": "推送私聊",
                        "type": "bool",
                        "hint": "推送该玩家的私聊消息",
                        "default": false
                    }
                }
            }
        },
        "default": []
    },
    "allowed_groups": {
        "description": "允许使用的群号列表",
        "type": "list",
        "hint": "留空表示所有群都可用；填写后仅这些群可使用 Minecraft 命令。",
        "default": []
    },
    "blocked_groups": {
        "description": "禁止使用的群号列表",
        "type": "list",
        "hint": "这些群无法使用 Minecraft 命令（优先级高于白名单）。",
        "default": []
    }
}
